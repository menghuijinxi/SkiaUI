{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-vcpkg",
      "displayName": "Visual Studio 2026 (vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../out/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "SKIATEST_USE_SKIA_D3D": "ON"
      }
    },
    {
      "name": "ninja-vcpkg",
      "displayName": "Ninja (vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../out/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "SKIATEST_USE_SKIA_D3D": "ON"
      }
    },
    {
      "name": "ue55-v143-libpng15",
      "displayName": "UE 5.5 / MSVC 14.38 / libpng 1.5.2",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v143,version=14.38.33130",
      "binaryDir": "${sourceDir}/build/ue55-v143-libpng15",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/ue55-v143-libpng15/install",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../out/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-ue55",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays/ue55-ports;${sourceDir}/cmake/vcpkg-overlays/ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "SKIAUI_REQUIRED_LIBPNG_VERSION": "1.5.2",
        "SKIAUI_ENABLE_FFMPEG_VIDEO": "ON",
        "SKIAUI_BUILD_DEMOS": "OFF",
        "BUILD_TESTING": "ON",
        "SKIATEST_USE_SKIA_D3D": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vcpkg-release",
      "configurePreset": "windows-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "ninja-vcpkg-release",
      "configurePreset": "ninja-vcpkg"
    },
    {
      "name": "ue55-v143-libpng15-release",
      "configurePreset": "ue55-v143-libpng15",
      "configuration": "Release"
    }
  ]
}
